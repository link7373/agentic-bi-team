<?xml version="1.0" encoding="utf-8"?>
<!--
  Companion shim for the W3C XML namespace. NOT shipped by Tableau, NOT the W3C
  original.

  twb_<version>.xsd contains:

      <xs:import namespace="http://www.w3.org/XML/1998/namespace"/>

  with no schemaLocation, and then references xml:base. libxml2 does not supply
  this namespace automatically when building a schema, so loading fails with:

      The QName value '{http://www.w3.org/XML/1998/namespace}base' does not
      resolve to a(n) attribute declaration.

  The canonical definition lives at https://www.w3.org/2001/xml.xsd. This is a
  minimal local equivalent of the four attributes that schema declares, so that
  validation works offline with no network fetch at run time.

  Part of the Agentic BI Team. Created by Colin Beck.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.w3.org/XML/1998/namespace"
           xmlns:xml="http://www.w3.org/XML/1998/namespace">

  <xs:attribute name="base" type="xs:anyURI"/>
  <xs:attribute name="id" type="xs:ID"/>
  <xs:attribute name="lang" type="xs:string"/>
  <xs:attribute name="space">
    <xs:simpleType>
      <xs:restriction base="xs:NCName">
        <xs:enumeration value="default"/>
        <xs:enumeration value="preserve"/>
      </xs:restriction>
    </xs:simpleType>
  </xs:attribute>

  <xs:attributeGroup name="specialAttrs">
    <xs:attribute ref="xml:base"/>
    <xs:attribute ref="xml:lang"/>
    <xs:attribute ref="xml:space"/>
    <xs:attribute ref="xml:id"/>
  </xs:attributeGroup>

</xs:schema>
