# Agentic BI Team — environment variable template
#
# Copy to .env (gitignored) or set these in your shell profile, then reference
# them by NAME in the commands you record in knowledge/data-sources.md:
#
#     psql "$PROD_REPLICA_URL" -c "SELECT 1"
#
# The distinction matters: the shell resolves the value, so the credential never
# enters an agent's context. .claude/settings.json additionally denies reading
# .env outright — a secret an agent never sees cannot end up in a transcript, a
# log, or a deliverable.
#
# Only fill in the block for the warehouse you actually use. Delete the rest.
# Prefer a READ-ONLY role or a read replica everywhere it is offered.

# ---------------------------------------------------------------------------
# Postgres / Redshift
# ---------------------------------------------------------------------------
# PROD_REPLICA_URL=postgresql://readonly_user:CHANGEME@replica.example.com:5432/analytics
# PGSSLMODE=require

# ---------------------------------------------------------------------------
# BigQuery
# ---------------------------------------------------------------------------
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# BIGQUERY_PROJECT=my-analytics-project
# BIGQUERY_LOCATION=US
# Cost guardrail: bq query --maximum_bytes_billed=... — record the ceiling in
# knowledge/data-sources.md so agents estimate before scanning.

# ---------------------------------------------------------------------------
# Snowflake
# ---------------------------------------------------------------------------
# SNOWFLAKE_ACCOUNT=xy12345.us-east-1
# SNOWFLAKE_USER=bi_readonly
# SNOWFLAKE_PASSWORD=CHANGEME
# SNOWFLAKE_ROLE=ANALYST_RO
# SNOWFLAKE_WAREHOUSE=ANALYTICS_WH
# SNOWFLAKE_DATABASE=PROD
# SNOWFLAKE_SCHEMA=MARTS

# ---------------------------------------------------------------------------
# MySQL / MariaDB
# ---------------------------------------------------------------------------
# MYSQL_HOST=replica.example.com
# MYSQL_USER=bi_readonly
# MYSQL_PWD=CHANGEME
# MYSQL_DATABASE=analytics

# ---------------------------------------------------------------------------
# Databricks / Trino / ClickHouse
# ---------------------------------------------------------------------------
# DATABRICKS_HOST=https://adb-000000000000.0.azuredatabricks.net
# DATABRICKS_TOKEN=CHANGEME
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/abc123
# TRINO_HOST=trino.example.com
# CLICKHOUSE_URL=https://user:CHANGEME@clickhouse.example.com:8443

# ---------------------------------------------------------------------------
# Local / file-based (no credentials needed)
# ---------------------------------------------------------------------------
# DUCKDB_PATH=data/local.duckdb
# SQLITE_PATH=demo/demo.db

# ---------------------------------------------------------------------------
# Source systems (only if the team extracts from them directly)
# ---------------------------------------------------------------------------
# STRIPE_API_KEY=rk_live_CHANGEME          # restricted key, read-only scopes
# SALESFORCE_INSTANCE_URL=https://example.my.salesforce.com
# SALESFORCE_TOKEN=CHANGEME
# GA4_PROPERTY_ID=123456789

# ---------------------------------------------------------------------------
# Scheduling (see scheduling/SCHEDULING.md)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=CHANGEME               # for unattended `claude -p` runs
